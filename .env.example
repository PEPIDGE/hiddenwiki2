# ============================================================
# HIDDEN WIKI 2 — environment (copy to .env.local and fill in)
# ============================================================

# Neon Postgres connection string (Neon dashboard → Connect → pooled).
# When set, players, coins, clues and all progress are stored in Neon.
# When empty, a local file store (.data/) is used — development only.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Secret used to sign session cookies (HMAC-SHA256).
# REQUIRED in production, at least 32 random characters.
HC_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Access code of the seed player (the first code you hand out).
HC_SEED_CODE=HW2-XXXX-XXXX
