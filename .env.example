# ============================================================
# HIDDEN WIKI 2 — environment (copy to .env.local and fill in)
# ============================================================

# Secret used to sign session cookies (HMAC-SHA256).
# REQUIRED in production. Use a long, random value (min 32 chars).
HC_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Access code for the seed player (the first login code you hand out).
HC_SEED_CODE=HW2-XXXX-XXXX

# Optional: Neon / Postgres connection string for a persistent player
# store. Leave unset to use the local file store (.data/, dev only).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
